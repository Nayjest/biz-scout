# === Perplexity Connection ===
PERPLEXITY_API_KEY=
PERPLEXITY_API_BASE=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar-pro

# === OLLAMA ===
OLLAMA_MODEL=qwen3.5:9b
EMBEDDING_MODEL=paraphrase-multilingual
OLLAMA_CONTEXT_LENGTH=16384

# === RAG ===
LLM_API_TYPE=openai
LLM_API_KEY=ollama
LLM_API_BASE=http://localhost:11434/v1
MODEL=qwen3.5:9b
EMBEDDING_API_URL=http://localhost:11434/api/embeddings

# Too slow on local models with big DOCUMENTS_IN_CONTEXT number
RAG_GROUNDING_CHECK=No
DOCUMENTS_IN_CONTEXT=20
MAX_DOC_CHARS=2000
MAX_COMPANIES_IN_PROMPT=30
# Max number of recent chat messages kept in the conversation sent to the LLM.
MAX_CONVERSATION_MESSAGES=10

# === INDEXING ===
# Be careful to not exceed Perplexity's rate limits
MAX_CONCURRENT_TASKS=5
PAGES_PER_SUBJECT=2
# Cap on how many data-collecting subjects (questions) are used per company
MAX_DATA_COLLECTING_QUESTIONS=50